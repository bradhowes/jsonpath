{
  "name": "@bradhowes/jsonpath",
  "version": "1.3.1",
  "description": "Query JavaScript objects with JSONPath expressions. Robust / safe JSONPath engine for Node.js.",
  "keywords": [
    "JSONPath",
    "jsonpath",
    "json-path",
    "object",
    "traversal",
    "json",
    "path",
    "data structures"
  ],
  "homepage": "https://github.com/dchester/jsonpath#readme",
  "bugs": {
    "url": "https://github.com/dchester/jsonpath/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bradhowes/jsonpath.git"
  },
  "license": "MIT",
  "author": "david@fmail.co.uk",
  "type": "commonjs",
  "main": "index.js",
  "browser": "./jsonpath.js",
  "bin": {
    "jsonpath": "bin/generate_parser.js"
  },
  "directories": {
    "lib": "lib",
    "test": "test"
  },
  "scripts": {
    "prepublishOnly": "node lib/aesprim.js > generated/aesprim-browser.js",
    "test": "mocha -u tdd test && jshint lib",
    "generate": "node bin/generate_parser.js > generated/parser.js"
  },
  "dependencies": {
    "esprima": "1.2.5",
    "static-eval": "2.1.1",
    "underscore": "^1.13.8"
  },
  "devDependencies": {
    "grunt": "0.4.5",
    "grunt-browserify": "3.8.0",
    "grunt-cli": "0.1.13",
    "grunt-contrib-uglify": "0.9.1",
    "jison": "0.4.13",
    "jscs": "1.10.0",
    "jshint": "2.6.0",
    "mocha": "2.1.0"
  },
  "alias": {
    "./lib/aesprim.js": "./generated/aesprim-browser.js"
  }
}
